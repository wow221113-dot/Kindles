{
  "name": "kindle",
  "version": "1.1.1",
  "description": "Kindle chat app",
  "author": "Kindle",
  "main": "main.js",
  "scripts": {
    "start": "electron ."
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.kindle.chat",
    "productName": "Kindle",
    "files": [
      "main.js",
      "index.html",
      "manifest.webmanifest",
      "sw.js",
      "icon-192.png",
      "icon-512.png",
      "icon-maskable-512.png"
    ],
    "win": {
      "target": "nsis",
      "icon": "icon-512.png"
    },
    "nsis": {
      "oneClick": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Kindle",
      "runAfterFinish": true
    }
  }
}